          "name": "PRE-REQUEST: Login to Get Token",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.sendRequest({",
                  "  url: 'http://localhost:8000/api/v1/sanctum/token',",
                  "  method: 'POST',",
                  "  header: {'Content-Type': 'application/json'},",
                  "  body: {",
                  "    mode: 'raw',",
                  "    raw: JSON.stringify({",
                  "      email: 'ahlun.nazar2215@gmail.com',",
                  "      password: 'password'",
                  "    })",
                  "  }",
                  "}, function (err, response) {",
                  "  if (!err && response.json().token) {",
                  "    pm.environment.set('user_token', response.json().token);",
                  "    console.log('Token obtained successfully');",
                  "  } else {",
                  "    console.log('Login failed:', err || response.json().message);",
                  "  }",
                  "});"
                ]
              }
            }
          ],
